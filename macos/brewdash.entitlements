<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Under the hardened runtime, the osascript that brewdash.py runs to have Finder trash an app, and the one
     install.sh runs to quit brewdash before an update, send Apple Events on brewdash.app's behalf. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
